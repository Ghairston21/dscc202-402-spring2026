{
  "datasets": [
    {
      "name": "0493d00b",
      "displayName": "tweets_silver",
      "config": {
        "version": "1.1",
        "source": "workspace.default.tweets_silver",
        "dimensions": [
          {
            "name": "timestamp",
            "expr": "source.timestamp",
            "displayName": "Timestamp"
          },
          {
            "name": "mention",
            "expr": "source.mention",
            "displayName": "Mention"
          },
          {
            "name": "cleaned_text",
            "expr": "source.cleaned_text",
            "displayName": "Cleaned Text"
          },
          {
            "name": "text",
            "expr": "source.text",
            "displayName": "Text"
          },
          {
            "name": "sentiment",
            "expr": "source.sentiment",
            "displayName": "Sentiment"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "e4618e67",
      "displayName": "tweets_bronze",
      "config": {
        "version": "1.1",
        "source": "workspace.default.tweets_bronze",
        "dimensions": [
          {
            "name": "date",
            "expr": "source.date",
            "displayName": "Date"
          },
          {
            "name": "user",
            "expr": "source.user",
            "displayName": "User"
          },
          {
            "name": "text",
            "expr": "source.text",
            "displayName": "Text"
          },
          {
            "name": "sentiment",
            "expr": "source.sentiment",
            "displayName": "Sentiment"
          },
          {
            "name": "source_file",
            "expr": "source.source_file",
            "displayName": "Source File"
          },
          {
            "name": "processing_time",
            "expr": "source.processing_time",
            "displayName": "Processing Time"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "top_10_users",
      "displayName": "Top 10 Users by Tweet Count",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  user,\n  COUNT(*) as tweet_count\nFROM workspace.default.tweets_bronze GROUP BY user ORDER BY tweet_count DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "user",
            "expr": "user",
            "displayName": "User"
          }
        ],
        "measures": [
          {
            "name": "tweet_count",
            "expr": "SUM(tweet_count)",
            "displayName": "Tweet Count"
          }
        ]
      }
    },
    {
      "name": "top_10_positive",
      "displayName": "Top 10 Most Positively Mentioned",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  mention,\n  positive\nFROM workspace.default.gold_tweet_aggregations WHERE mention IS NOT NULL ORDER BY positive DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "mention",
            "expr": "mention",
            "displayName": "Mention"
          }
        ],
        "measures": [
          {
            "name": "positive_count",
            "expr": "SUM(positive)",
            "displayName": "Positive Count"
          }
        ]
      }
    },
    {
      "name": "top_10_negative",
      "displayName": "Top 10 Most Negatively Mentioned",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  mention,\n  negative\nFROM workspace.default.gold_tweet_aggregations WHERE mention IS NOT NULL ORDER BY negative DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "mention",
            "expr": "mention",
            "displayName": "Mention"
          }
        ],
        "measures": [
          {
            "name": "negative_count",
            "expr": "SUM(negative)",
            "displayName": "Negative Count"
          }
        ]
      }
    }
  ],
